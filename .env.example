# --- App ---
ENV=
MODO_SILENCIO_ELECTORAL=

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Redis ---
REDIS_URL=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Gemini ---
GEMINI_API_KEY=

# --- Embeddings: proveedor activo ---
# gemini | openai. Cambiarlo exige reindexar TODO el corpus (los vectores de modelos
# distintos no son comparables). Con openai se usa text-embedding-3-small a 768 dim.
EMBEDDING_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ingesta: webhook GitHub -> n8n -> /api/v1/ingest ---
GITHUB_WEBHOOK_SECRET=
INGEST_API_TOKEN=

# --- CORS ---
# Separados por coma, sin espacios sobrantes ni "/" final. Ejemplo:
# ALLOWED_ORIGINS=https://lodicho.zamarrito.com,http://localhost:8000
ALLOWED_ORIGINS=

# --- Nginx / Certbot ---
DOMAIN=
CERTBOT_EMAIL=

# --- Panel de admin (carga de corpus desde el front) ---
# ADMIN_PASSWORD: la clave para entrar al panel. ADMIN_SESSION_SECRET:
# distinta, para firmar las sesiones (generar con: openssl rand -hex 32).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# git@github.com:Jav-owl/lodicho-corpus.git — el backend pushea aca
# directo, sin depender del remote "origin" del checkout local.
CORPUS_GIT_REMOTE=git@github.com:Jav-owl/lodicho-corpus.git
# Ruta DENTRO del contenedor a la deploy key SSH (solo escritura en
# lodicho-corpus). Se monta en docker-compose.yml desde ./secrets/.
CORPUS_GIT_SSH_KEY=/run/secrets/corpus_deploy_key
